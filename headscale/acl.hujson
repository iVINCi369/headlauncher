{
  // HeadLauncher default policy: every node sees every node, internet via exit nodes,
  // and two tags for one-tap approval from the panel.
  "tagOwners": {
    "tag:exit":   ["__USER__@"],
    "tag:router": ["__USER__@"],
  },
  "autoApprovers": {
    "exitNode": ["tag:exit"],
  },
  // Tailscale ≥1.102 on iOS/macOS shows an empty exit-node list against headscale
  // unless the control plane "suggests" one (juanfont/headscale#3415). Harmless otherwise.
  "nodeAttrs": [
    { "target": ["*"], "attr": ["suggest-exit-node", "suggest-exit-node-ui"] },
  ],
  "acls": [
    { "action": "accept", "src": ["*"], "dst": ["*:*"] },
    { "action": "accept", "src": ["*"], "dst": ["autogroup:internet:*"] },
  ],
}
