# Written by install.sh — edit only if you know what you are doing.
DOMAIN=vpn.example.com
BOT_TOKEN=123456:ABC...
BOT_USERNAME=my_vpn_bot
ADMINS=                 # comma-separated Telegram user IDs; empty = claim with CLAIM_CODE
CLAIM_CODE=             # one-time code: https://t.me/<bot>?start=<code>
HS_API=                 # headscale API key (created by install.sh)
HS_USER=admin           # default headscale user for keys
HEADSCALE_VERSION=v0.29.3
BOT_VERSION=latest
STACK_DIR=/opt/headlauncher
LANG_DEFAULT=en         # fallback when Telegram language is unknown
EXIT_HOSTS=             # optional: node=user@host;node2=local  (exit-node button over SSH)
# --- attach mode only (existing headscale) ---
MODE=full               # full | attach
#COMPOSE_FILE=docker-compose.attach.yml
#HS_URL=https://vpn.example.com        # public server_url of your headscale
#HS_API_URL=http://127.0.0.1:8080      # its API as seen from this host
#LISTEN=127.0.0.1:8090                 # bot/panel port; proxy /tg/ here
